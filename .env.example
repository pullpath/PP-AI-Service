# DeepSeek API Configuration
DEEPSEEK_API_KEY=

# Vision provider for /api/see: openai (default) | deepseek
AI_PROVIDER=openai
# Optional overrides (OPENAI_API_BASE above still works as the OpenAI base url)
OPENAI_BASE_URL=
OPENAI_MODEL=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

# OpenAI Configuration (optional - for audio transcription if needed)
OPENAI_API_KEY=
OPENAI_API_BASE=
X-PP-TOKEN=

# Other Services
SERPER_API_KEY=
BROWSERLESS_API_KEY=

# Flask Related Config
FLASK_ENV=

# YouTube Data API Key
YOUTUBE_DATA_API_KEY=

# Bilibili API Configuration (optional - for subtitle access in video search)
# Get these from your browser's developer tools after logging into Bilibili
# Application tab > Cookies > https://www.bilibili.com
BILIBILI_SESSDATA=
BILIBILI_BILI_JCT=
BILIBILI_BUVID3=
BILIBILI_AC_TIME_VALUE=

# Admin Token (for cache management endpoints)
# Generate a secure random token: python -c "import secrets; print(secrets.token_urlsafe(32))"
# If not set, a temporary token will be auto-generated on server start
ADMIN_TOKEN=

# Bite Dance AI Service
ARK_API_KEY=
TOS_ACCESS_KEY=
TOS_SECRET_KEY=

# GCP Configuration
GCP_SERVICE_ACCOUNT_FILE=

# Storage Configuration
BUCKET_NAME_PREFIX=